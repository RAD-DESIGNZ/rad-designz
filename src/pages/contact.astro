---
import Base from '../layouts/Base.astro';
---
<Base title="Contact — RAD DESIGNZ" description="Get in touch with RAD DESIGNZ about a brand identity, logo, packaging or creative direction project.">
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><h2>Contact</h2></div>
      <div class="split">
        <div>
          <p class="lede">
            Tell us what you are building, who it is for, and when you need it.
          </p>
          <ul class="contact-list">
            <li><a href="mailto:raddesignz.studio@gmail.com">raddesignz.studio@gmail.com</a></li>
            <li><a href="https://instagram.com/raddesignz" rel="me noopener">Instagram</a></li>
            <li><a href="https://behance.net/raddesignz" rel="me noopener">Behance</a></li>
            <li><a href="https://linktr.ee/raddesignz" rel="me noopener">Linktree</a></li>
          </ul>
        </div>
        <aside class="panel">
          <h3>Useful in a first message</h3>
          <ul class="svc">
            <li>What the project is</li>
            <li>Who the audience is</li>
            <li>Deadline</li>
            <li>Budget range</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>
</Base>
