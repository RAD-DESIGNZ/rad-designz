---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('pages', 'contact');
const d = entry!.data;

---
<Base title={`${d.heading} — RAD DESIGNZ`} description={d.lede}>
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><h2>{d.heading}</h2></div>
      <div class="split">
        <div>
          <p class="lede">{d.lede}</p>
          <ul class="contact-list">
            {d.email && <li><a href={`mailto:${d.email}`}>{d.email}</a></li>}
            {d.behance && <li><a href={d.behance} rel="me noopener" target="_blank">Behance</a></li>}
          </ul>
        </div>
        {d.panel_items.length > 0 && (
          <aside class="panel">
            <h3>{d.panel_title}</h3>
            <ul class="svc">
              {d.panel_items.map(i => <li>{i}</li>)}
            </ul>
          </aside>
        )}
      </div>
    </div>
  </section>
</Base>
