---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { CATEGORIES } from '../lib/categories';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const filters = [
  { key: 'all', label: 'All' },
  ...CATEGORIES.map(c => ({ key: c.value, label: c.label }))
];
---
<Base title="Projects — RAD DESIGNZ" description="Brand identity, logo, packaging and creative direction work by RAD DESIGNZ.">
  <section class="sec">
    <div class="deco" aria-hidden="true">
      <span class="ring" style="color:var(--pink);width:170px;height:170px;right:4%;top:4%"></span>
      <span class="disc" style="color:var(--purple);width:180px;height:180px;left:-60px;top:34%"></span>
      <span class="ring" style="color:var(--lavender);width:70px;height:70px;right:14%;bottom:6%"></span>
    </div>
    <div class="wrap">
      <div class="sec-head"><h2>Projects</h2></div>

      <div class="filter-bar">
        <div class="filter-wrap">
          <button class="filter-toggle" id="filter-toggle" aria-expanded="false" aria-controls="filter-panel">
            <span class="ft-key">Discipline</span>
            <span class="ft-val" id="filter-current">All</span>
            <span class="ft-caret" aria-hidden="true"></span>
          </button>
          <div class="filter-panel" id="filter-panel" role="listbox" aria-label="Filter projects by discipline" hidden>
            {filters.map((f, i) => (
              <button class="filter-opt" role="option" data-filter={f.key}
                      aria-selected={i === 0 ? 'true' : 'false'}>{f.label}</button>
            ))}
          </div>
        </div>
        <p class="filter-count" id="filter-count"></p>
      </div>

      {projects.length === 0 ? (
        <p class="empty">No projects published yet.</p>
      ) : (
        <div class="grid" id="project-grid">
          {projects.map(p => (
            <ProjectCard
              href={`/projects/${p.id}`}
              title={p.data.title}
              cover={p.data.cover}
              client={p.data.client}
              year={p.data.year}
              categories={p.data.category}
            />
          ))}
        </div>
      )}
      <p class="empty" id="no-results" hidden>Nothing in this discipline yet.</p>
    </div>
  </section>
</Base>

<script>
  const toggle = document.getElementById('filter-toggle') as HTMLButtonElement | null;
  const panel = document.getElementById('filter-panel');
  const current = document.getElementById('filter-current');
  const count = document.getElementById('filter-count');
  const opts = document.querySelectorAll<HTMLButtonElement>('.filter-opt');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid .card');
  const none = document.getElementById('no-results');

  const setOpen = (open: boolean) => {
    if (!panel || !toggle) return;
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
  };

  const apply = (key: string, label: string) => {
    let visible = 0;
    cards.forEach(card => {
      const own = (card.dataset.category ?? '').split(' ').filter(Boolean);
      const match = key === 'all' || own.includes(key);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (current) current.textContent = label;
    if (none) none.hidden = visible !== 0;
    if (count) count.textContent = visible === cards.length
      ? `${cards.length} project${cards.length === 1 ? '' : 's'}`
      : `${visible} of ${cards.length}`;
  };

  toggle?.addEventListener('click', () => setOpen(panel?.hidden ?? false));

  opts.forEach(opt => {
    opt.addEventListener('click', () => {
      opts.forEach(o => o.setAttribute('aria-selected', String(o === opt)));
      apply(opt.dataset.filter ?? 'all', opt.textContent ?? 'All');
      setOpen(false);
      toggle?.focus();
    });
  });

  document.addEventListener('click', e => {
    if (!panel || panel.hidden) return;
    const t = e.target as Element | null;
    if (!t || !t.closest('.filter-wrap')) setOpen(false);
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && panel && !panel.hidden) { setOpen(false); toggle?.focus(); }
  });

  apply('all', 'All');
</script>
