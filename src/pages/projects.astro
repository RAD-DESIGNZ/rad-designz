---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { DISCIPLINES, disciplineOf } from '../lib/categories';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const filters = [
  { key: 'all', label: 'All' },
  ...DISCIPLINES.map(c => ({ key: c.value, label: c.label }))
];
---
<Base title="Projects — RAD DESIGNZ" description="Brand identity, logo, packaging, UI/UX and visual design work by RAD DESIGNZ.">
  <section class="sec">
    <div class="wrap">
      <img class="deco deco-bg deco-bg-tr" src="/illustrations/camera.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="sec-head"><h2>Projects</h2></div>

      <div class="filter-bar">
        <div class="chips" role="group" aria-label="Filter projects by discipline">
          {filters.map((f, i) => (
            <button class="chip" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
        <p class="filter-count" id="filter-count"></p>
      </div>

      {projects.length === 0 ? (
        <p class="empty">No projects published yet.</p>
      ) : (
        <div class="grid" id="project-grid">
          {projects.map(p => (
            <ProjectCard
              href={`/projects/${p.id}`}
              title={p.data.title}
              cover={p.data.cover}
              year={p.data.year}
              categories={p.data.category}
              summary={p.data.summary}
              coverAnimated={p.data.cover_animated}
              coverStart={p.data.cover_animated_start}
              discipline={disciplineOf(p.data)}
            />
          ))}
        </div>
      )}
      <p class="empty" id="no-results" hidden>Nothing in this discipline yet.</p>
    </div>
  </section>
</Base>

<script>
  const count = document.getElementById('filter-count');
  const opts = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid .card');
  const none = document.getElementById('no-results');

  // Each project belongs to exactly one discipline.
  const apply = (key: string) => {
    let visible = 0;
    cards.forEach(card => {
      const match = key === 'all' || card.dataset.discipline === key;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    opts.forEach(o => o.setAttribute('aria-pressed', String(o.dataset.filter === key)));
    if (none) none.hidden = visible !== 0;
    if (count) count.textContent = visible === cards.length
      ? `${cards.length} project${cards.length === 1 ? '' : 's'}`
      : `${visible} of ${cards.length}`;
  };

  opts.forEach(opt => opt.addEventListener('click', () => apply(opt.dataset.filter ?? 'all')));

  // Arriving from About: /projects?d=branding pre-selects that discipline.
  const wanted = new URLSearchParams(location.search).get('d');
  const known = Array.from(opts).some(o => o.dataset.filter === wanted);
  apply(wanted && known ? wanted : 'all');
</script>
