---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = await getCollection('projects');
const featured = all
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const shown = featured.length ? featured : all.sort((a, b) => a.data.order - b.data.order).slice(0, 4);
---
<Base title="RAD DESIGNZ — Brand identity, logo, packaging, creative direction">
  <section class="hero">
    <div class="deco" aria-hidden="true">
      <span class="ring" style="color:var(--pink);width:190px;height:190px;right:6%;top:8%"></span>
      <span class="ring" style="color:var(--purple);width:110px;height:110px;right:22%;top:46%"></span>
      <span class="disc" style="color:var(--pink);width:150px;height:150px;left:-40px;bottom:12%"></span>
      <span class="ring" style="color:var(--lavender);width:64px;height:64px;right:11%;bottom:14%"></span>
    </div>
    <div class="wrap">
      <h1>Rad<span>Designz</span></h1>
      <p class="lede hero-lede">
        We design brands and everything they touch.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/projects">See the projects</a>
        <a class="btn btn-ghost" href="/contact">Start a project</a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="deco" aria-hidden="true">
      <span class="disc" style="color:var(--purple);width:210px;height:210px;right:-70px;top:14%"></span>
      <span class="ring" style="color:var(--pink);width:90px;height:90px;left:3%;bottom:8%"></span>
    </div>
    <div class="wrap">
      <div class="sec-head">
        <h2>Selected projects</h2>
        <a href="/projects">All projects</a>
      </div>
      {shown.length === 0 ? (
        <p class="empty">No projects published yet.</p>
      ) : (
        <div class="grid">
          {shown.map(p => (
            <ProjectCard
              href={`/projects/${p.id}`}
              title={p.data.title}
              cover={p.data.cover}
              client={p.data.client}
              year={p.data.year}
              categories={p.data.category}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
