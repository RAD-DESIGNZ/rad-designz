---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { labelFor, sortCategories } from '../lib/categories';

const all = await getCollection('projects');
const sorted = all.sort((a, b) => a.data.order - b.data.order);

// Every project marked "Show on homepage" — no limit.
const featured = sorted.filter(p => p.data.featured);
const shown = featured.length ? featured : sorted;

// The showcase rotates through the same set.
const slides = shown.map(p => ({
  href: `/projects/${p.id}`,
  title: p.data.title,
  cover: p.data.cover,
  summary: p.data.summary,
  meta: `${sortCategories(p.data.category).map(labelFor).join(' · ')} — ${p.data.year}`
}));
---
<Base title="RAD DESIGNZ — Brand identity, logo, packaging, creative direction">
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-text">
        <h1 class="sr-only">RAD DESIGNZ</h1>
        <p class="lede hero-lede">
          We design brands and everything they touch.
        </p>
      </div>
      <div class="hero-actions">
        <a class="btn" href="/projects">See the projects</a>
        <a class="btn btn-ghost" href="/contact">Start a project</a>
      </div>
    </div>
  </section>

  {slides.length > 1 && (
    <section class="sec sec-tight sec-showcase">
      <div class="wrap">
        <div class="showcase-stage">
        <a class="showcase" id="showcase" href={slides[0].href} aria-label="Featured project">
          <div class="showcase-frame" id="showcase-frame">
            {slides.map((s, i) => (
              <img class={i === 0 ? 'is-on' : ''} src={s.cover} alt="" data-i={i}
                   loading={i === 0 ? 'eager' : 'lazy'} />
            ))}
          </div>
          <div class="showcase-text">
            <h2 id="showcase-title">{slides[0].title}</h2>
          </div>
        </a>
        <div class="showcase-nav">
          <button type="button" class="showcase-arrow showcase-prev" id="showcase-prev" aria-label="Previous project"><svg viewBox="0 0 16 26" aria-hidden="true"><polygon points="1.5,1.5 7.5,1.5 15,13 7.5,24.5 1.5,24.5 9.5,13" /></svg></button>
          <button type="button" class="showcase-arrow showcase-next" id="showcase-next" aria-label="Next project"><svg viewBox="0 0 16 26" aria-hidden="true"><polygon points="1.5,1.5 7.5,1.5 15,13 7.5,24.5 1.5,24.5 9.5,13" /></svg></button>
        </div>
        </div>
        <script type="application/json" id="showcase-data" set:html={JSON.stringify(slides)} />
      </div>
    </section>
  )}

  <section class="sec sec-tight">
    <div class="wrap">
      <div class="sec-head sec-head-bare">
        <a class="see-all" href="/projects">See all projects</a>
      </div>
      {shown.length === 0 ? (
        <p class="empty">No projects published yet.</p>
      ) : (
        <div class="grid">
          {shown.map(p => (
            <ProjectCard
              href={`/projects/${p.id}`}
              title={p.data.title}
              cover={p.data.cover}
              year={p.data.year}
              categories={p.data.category}
              summary={p.data.summary}
              coverAnimated={p.data.cover_animated}
              coverStart={p.data.cover_animated_start}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  const root = document.getElementById('showcase') as HTMLAnchorElement | null;
  const frame = document.getElementById('showcase-frame');
  const dataEl = document.getElementById('showcase-data');

  if (root && frame && dataEl) {
    type Slide = { href: string; title: string; cover: string; summary: string; meta: string };
    const slides: Slide[] = JSON.parse(dataEl.textContent || '[]');
    const imgs = Array.from(frame.querySelectorAll<HTMLImageElement>('img'));
    const elTitle = document.getElementById('showcase-title')!;

    /** The most common colour around an image's border, as one flat colour,
     *  so the letterbox matches the image's own background. Runs for every
     *  image, so new or changed project covers match automatically. */
    const edgeColour = (img: HTMLImageElement): string => {
      try {
        const n = 48;
        const c = document.createElement('canvas');
        c.width = n; c.height = n;
        const ctx = c.getContext('2d', { willReadFrequently: true });
        if (!ctx) return '';
        ctx.drawImage(img, 0, 0, n, n);
        const d = ctx.getImageData(0, 0, n, n).data;
        const buckets = new Map<number, [number, number, number, number]>();
        for (let y = 0; y < n; y++) {
          for (let x = 0; x < n; x++) {
            const onEdge = x < 2 || y < 2 || x > n - 3 || y > n - 3;
            if (!onEdge) continue;
            const i = (y * n + x) * 4;
            if (d[i + 3] < 200) continue;
            const key = ((d[i] >> 4) << 8) | ((d[i + 1] >> 4) << 4) | (d[i + 2] >> 4);
            const b = buckets.get(key) || [0, 0, 0, 0];
            b[0] += d[i]; b[1] += d[i + 1]; b[2] += d[i + 2]; b[3]++;
            buckets.set(key, b);
          }
        }
        let best: [number, number, number, number] | null = null;
        buckets.forEach(b => { if (!best || b[3] > best[3]) best = b; });
        if (!best) return '';
        const [r, g, bl, k] = best;
        return `rgb(${Math.round(r / k)}, ${Math.round(g / k)}, ${Math.round(bl / k)})`;
      } catch {
        return '';
      }
    };

    const paint = (img: HTMLImageElement) => {
      const apply = () => {
        const c = edgeColour(img);
        if (c) frame.style.backgroundColor = c;
      };
      img.complete ? apply() : img.addEventListener('load', apply, { once: true });
    };

    let i = 0;
    paint(imgs[0]);

    const show = (next: number) => {
      imgs[i].classList.remove('is-on');
      i = next;
      imgs[i].classList.add('is-on');
      const s = slides[i];
      elTitle.textContent = s.title;
      root.href = s.href;
      paint(imgs[i]);
    };

    const next = () => show((i + 1) % slides.length);
    const prev = () => show((i - 1 + slides.length) % slides.length);

    // Rotates every 2 seconds and keeps going on hover.
    // The arrows step through by hand; each click restarts the 2 seconds.
    const auto = slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = 0;
    const restart = () => {
      if (!auto) return;
      window.clearInterval(timer);
      timer = window.setInterval(next, 2000);
    };
    document.getElementById('showcase-prev')?.addEventListener('click', () => { prev(); restart(); });
    document.getElementById('showcase-next')?.addEventListener('click', () => { next(); restart(); });
    restart();
  }
</script>
