---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('pages', 'about');
const d = entry!.data;
const { Content } = await render(entry!);
---
<Base title={`${d.heading} — RAD DESIGNZ`} description={d.lede}>
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><h2>{d.heading}</h2></div>
      <div class="split">
        <div>
          <p class="lede">{d.lede}</p>
          <Content />
        </div>
        {d.panel_items.length > 0 && (
          <aside class="panel">
            <h3>{d.panel_title}</h3>
            <ul class="svc">
              {d.panel_items.map(i => <li>{i}</li>)}
            </ul>
          </aside>
        )}
      </div>
    </div>
  </section>
</Base>
