---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { DISCIPLINES } from '../lib/categories';

const entry = await getEntry('pages', 'about');
const d = entry!.data;
const { Content } = await render(entry!);
---
<Base title={`${d.heading} — RAD DESIGNZ`} description={d.lede}>
  <section class="sec">
    <div class="wrap">
      <img class="deco deco-bg deco-bg-l" src="/illustrations/vinyl.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="sec-head"><h2>{d.heading}</h2></div>
      <div class="split">
        <div>
          <p class="lede">{d.lede}</p>
          <Content />
        </div>
        <aside class="panel">
          <h3>{d.panel_title || 'What we do'}</h3>
          <ul class="svc svc-links">
            {DISCIPLINES.map(c => (
              <li><a href={`/projects?d=${c.value}`}>{c.label}</a></li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>
</Base>
