---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About us' },
  { href: '/contact', label: 'Contact' }
];
---
<header class="nav">
  <div class="nav-in">
    <a class="brand" href="/" aria-label="RAD DESIGNZ — home">
      <img class="brand-word" src="/logo/wordmark-rad-designz.png" alt="RAD DESIGNZ" width="682" height="256" />
    </a>
    <a class="nav-mark nav-eye" href="/" aria-label="RAD DESIGNZ — back to the top of the homepage">
      <span class="eye-inner">
        <img src="/logo/eye-rays.png" alt="" width="144" height="144" />
        <span class="eye-ball">
          <img src="/logo/eye-almond.png" alt="" width="144" height="144" />
          <img class="eye-iris" src="/logo/eye-iris.png" alt="" width="144" height="144" />
        </span>
      </span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        {links.map(l => (
          <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Eye mark: blinks every few seconds everywhere.
  // Mouse: the iris follows the pointer.
  // Touch screens: it looks where you tap or drag, glances up or down while
  // you scroll, and looks around on its own when nothing is happening.
  const eyeLink = document.querySelector<HTMLAnchorElement>('.nav-eye');
  const eye = eyeLink?.querySelector<HTMLElement>('.eye-inner');
  const iris = eye?.querySelector<HTMLElement>('.eye-iris');
  const ball = eye?.querySelector<HTMLElement>('.eye-ball');

  // Tapping the eye goes to the top of the homepage (smooth scroll if already there).
  eyeLink?.addEventListener('click', (e) => {
    if (location.pathname === '/') {
      e.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    }
  });

  // On phones the bar scrolls away; the eye stays pinned top-right, no background.
  if (eyeLink) {
    const phone = window.matchMedia('(max-width: 760px)');
    const pin = () => eyeLink.classList.toggle('is-floating', phone.matches && window.scrollY > 2);
    window.addEventListener('scroll', pin, { passive: true });
    phone.addEventListener('change', pin);
    pin();
  }

  if (eye && iris && ball && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const MAX_X = 7;    // % of the mark's width
    const MAX_Y = 3.5;  // % of the mark's height
    let mouse = false;                 // true once a real mouse has moved
    let mx: number | null = null, my: number | null = null;
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    let holdUntil = 0, wanderAt = 0, lastScroll = window.scrollY;

    // Direction from the eye to a point on screen, as an iris offset.
    const lookAt = (px: number, py: number) => {
      const r = eye.getBoundingClientRect();
      const dx = px - (r.left + r.width / 2);
      const dy = py - (r.top + r.height * 0.596);
      const d = Math.hypot(dx, dy) || 1;
      const k = Math.min(d / 260, 1);
      return [(dx / d) * k * MAX_X, (dy / d) * k * MAX_Y];
    };

    const step = (now: number) => {
      if (mouse) {
        if (mx !== null && my !== null) [tx, ty] = lookAt(mx, my);
        else tx = ty = 0;
      } else if (now > holdUntil && now > wanderAt) {
        // Nothing happening: glance somewhere, sometimes back to centre.
        if (Math.random() < 0.3) { tx = 0; ty = 0; }
        else { tx = (Math.random() * 2 - 1) * MAX_X * 0.8; ty = (Math.random() * 2 - 1) * MAX_Y * 0.6; }
        wanderAt = now + 1200 + Math.random() * 2300;
      }
      x += (tx - x) * 0.18;
      y += (ty - y) * 0.18;
      iris.style.transform = `translate(${x.toFixed(2)}%, ${y.toFixed(2)}%)`;
      // Keep running while moving, and on touch screens so the idle glances happen.
      const moving = Math.abs(tx - x) > 0.01 || Math.abs(ty - y) > 0.01;
      raf = moving || !mouse ? requestAnimationFrame(step) : 0;
    };
    const go = () => { if (!raf) raf = requestAnimationFrame(step); };

    const onPointer = (e: PointerEvent) => {
      if (e.pointerType === 'mouse') {
        mouse = true; mx = e.clientX; my = e.clientY;
      } else {
        mouse = false;
        [tx, ty] = lookAt(e.clientX, e.clientY);
        holdUntil = performance.now() + 1500;
        wanderAt = holdUntil;
      }
      go();
    };
    window.addEventListener('pointermove', onPointer, { passive: true });
    window.addEventListener('pointerdown', onPointer, { passive: true });
    document.addEventListener('pointerleave', () => { mx = my = null; go(); });

    window.addEventListener('scroll', () => {
      const dy = window.scrollY - lastScroll;
      lastScroll = window.scrollY;
      if (!mouse && dy !== 0) {
        tx *= 0.5;
        ty = Math.sign(dy) * MAX_Y * Math.min(Math.abs(dy) / 30, 1);
        holdUntil = performance.now() + 450;
        wanderAt = holdUntil + 600;
      }
      go();
    }, { passive: true });

    const blink = () => {
      ball.classList.remove('is-blinking');
      void ball.offsetWidth;
      ball.classList.add('is-blinking');
    };
    ball.addEventListener('animationend', () => ball.classList.remove('is-blinking'));

    const loop = () => {
      window.setTimeout(() => {
        blink();
        if (Math.random() < 0.3) window.setTimeout(blink, 260);
        loop();
      }, 1500 + Math.random() * 2500);
    };
    loop();
    go();
  }
</script>
