---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About us' },
  { href: '/contact', label: 'Contact' }
];
---
<header class="nav">
  <div class="nav-in">
    <a class="brand" href="/" aria-label="RAD DESIGNZ — home">
      <img class="brand-word" src="/logo/wordmark-252.png" alt="RAD DESIGNZ" width="339" height="252" />
    </a>
    <img class="nav-mark" src="/logo/eye-96.png" alt="" width="96" height="96" aria-hidden="true" />
    <nav aria-label="Main">
      <ul class="nav-links">
        {links.map(l => (
          <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
