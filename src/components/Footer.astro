---
import { getEntry } from 'astro:content';

const contact = await getEntry('pages', 'contact');
const c = contact?.data;
const email = c?.email ?? '';
const year = new Date().getFullYear();

const socials = [
  { href: c?.behance ?? '',   name: 'Behance',   id: 'be' },
  { href: c?.facebook ?? '',  name: 'Facebook',  id: 'fb' },
  { href: c?.instagram ?? '', name: 'Instagram', id: 'ig' }
].filter(s => s.href);
---
<footer class="foot">
  {socials.length > 0 && (
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <defs>
        <g id="be"><path d="M9.5 5.5H1v13h8.8c2.9 0 5-1.5 5-4.1 0-1.8-1-3-2.6-3.4 1.2-.5 1.9-1.6 1.9-3 0-2.3-1.8-3.5-4.6-3.5zm-.6 5.2H4.1V8h4.6c1.1 0 1.8.4 1.8 1.3 0 .9-.6 1.4-1.6 1.4zm.4 5.4H4.1v-3h5.2c1.3 0 2 .6 2 1.5 0 1-.7 1.5-2 1.5z"/><path d="M18.6 8.2c-3 0-5 2.1-5 5.1 0 3.1 1.9 5.1 5.1 5.1 2.4 0 4.1-1.1 4.7-3.2h-2.6c-.3.7-1 1.1-2 1.1-1.4 0-2.3-.8-2.4-2.3H23.5c.3-3.7-1.6-5.8-4.9-5.8zm-2.2 4.1c.2-1.3 1-2 2.2-2 1.3 0 2.1.7 2.2 2h-4.4zM16 5.3h6v1.6h-6z"/></g>
        <g id="fb"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c-.02-3.03 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07z"/></g>
        <g id="ig"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9a3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38A5.9 5.9 0 0 0 .63 4.14c-.3.76-.5 1.64-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.13-1.38a5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0z"/><path d="M12 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/><circle cx="18.41" cy="5.59" r="1.44"/></g>
      </defs>
    </svg>
  )}

  <div class="wrap">
    {socials.length > 0 && (
      <ul class="socials">
        {socials.map(s => (
          <li>
            <a href={s.href} rel="me noopener" target="_blank" aria-label={s.name}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href={`#${s.id}`} /></svg>
            </a>
          </li>
        ))}
      </ul>
    )}
    <div class="foot-in">
      <p style="margin:0">RAD DESIGNZ &copy; {year}</p>
      {email && <p style="margin:0"><a href={`mailto:${email}`}>{email}</a></p>}
    </div>
  </div>
</footer>
