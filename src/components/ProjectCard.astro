---
import { labelFor, sortCategories } from '../lib/categories';

interface Props {
  href: string;
  title: string;
  cover: string;
  client: string;
  year: number;
  categories: string[];
}
const { href, title, cover, client, year, categories } = Astro.props;
const ordered = sortCategories(categories);
const labels = ordered.map(labelFor).join(' · ');
---
<a class="card" href={href} data-category={ordered.join(' ')}>
  <div class="card-img">
    <img src={cover} alt={`Cover image for ${title}`} loading="lazy" width="800" height="600" />
  </div>
  <div class="card-body">
    <h3>{title}</h3>
    <p class="card-meta">{labels} — {client}, {year}</p>
  </div>
</a>
